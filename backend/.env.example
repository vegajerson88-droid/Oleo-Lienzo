APP_NAME="Óleo & Lienzo API"
ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./oleo_lienzo.db

JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcional: IA externa. Si se deja vacío, el diagnóstico y el endpoint de
# descripción sugerida informarán que el servicio no está configurado.
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_BASE_URL=https://api.openai.com/v1
EXTERNAL_AI_TIMEOUT_SECONDS=5.0
