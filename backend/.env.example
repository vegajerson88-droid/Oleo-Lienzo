# ─────────────────────────────────────────────────────────────────────────
#  Óleo & Lienzo — variables de entorno del backend
#  Copia este archivo a `.env` y rellena los valores reales.
#  NUNCA subas `.env` al repositorio: ya está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────────────────
APP_NAME="Óleo & Lienzo API"
APP_VERSION=5.0.0
ENVIRONMENT=development

# ── Base de datos PostgreSQL ─────────────────────────────────────────────
# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql+psycopg://oleo:tu_contraseña@localhost:5432/oleo_lienzo
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Seguridad / JWT ──────────────────────────────────────────────────────
# Genera una clave larga y aleatoria:  openssl rand -hex 32
JWT_SECRET_KEY=reemplaza-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT=20/minute

# ── CORS y frontend ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ── Inteligencia Artificial: Groq (plan gratuito) ────────────────────────
# Obtén la clave en https://console.groq.com/keys
# Si se deja vacía, el chatbot responde con su modo de respaldo local.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_TOKENS=500

# ── Pasarela de pago: Stripe ─────────────────────────────────────────────
# Claves de prueba en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cop

# ── Correo saliente (SMTP) ───────────────────────────────────────────────
# Con Gmail hay que usar una "contraseña de aplicación", no la del correo.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-responder@oleoylienzo.com
EMAIL_FROM_NAME="Óleo & Lienzo"
EMAIL_USE_TLS=true

# ── Datos fiscales de la empresa (facturas y correos) ────────────────────
EMPRESA_NOMBRE="Óleo & Lienzo S.A.S."
EMPRESA_NIT=901.234.567-8
EMPRESA_DIRECCION="Calle 45 # 12-30"
EMPRESA_CIUDAD="Bogotá D.C., Colombia"
EMPRESA_TELEFONO="+57 300 123 4567"
EMPRESA_EMAIL=contacto@oleoylienzo.com

# ── Reglas de negocio ────────────────────────────────────────────────────
IVA_PORCENTAJE=19
FACTURA_PREFIJO=OL
