# ─────────────────────────────────────────────────────────────────────────
#  Óleo & Lienzo — variables de entorno del frontend
#  Copia este archivo a `.env` y ajústalo. Vite solo expone al navegador
#  las variables que empiezan por VITE_, así que aquí nunca deben ponerse
#  secretos: todo lo sensible vive en backend/.env.
# ─────────────────────────────────────────────────────────────────────────

# URL del backend FastAPI (sin la barra final y sin /api).
VITE_API_URL=http://localhost:8000

# Número de WhatsApp del botón flotante, en formato internacional sin el +.
VITE_WHATSAPP_NUMERO=573001234567
